# Kopieer naar .env.local en vul in. .env.local komt nooit in Git.

# Analyse-engine: mock (standaard) of claude
CERTUM_ANALYSIS_PROVIDER=mock

# Blueprint Generation: mock (standaard) of claude. Los van de analyseprovider.
CERTUM_BLUEPRINT_PROVIDER=mock

# BC Online Block Plan: mock (standaard) of claude.
CERTUM_BLOCK_PLAN_PROVIDER=mock

# Block Content: mock (standaard) of claude. Eén aanroep per gepland blok.
CERTUM_BLOCK_CONTENT_PROVIDER=mock

# Alleen nodig als een van de providers hierboven op claude staat
ANTHROPIC_API_KEY=
